# Template for supabase/functions/.env.local. Copy it, fill it in, never commit
# the copy.
#
# You do not need any of this for normal local development: `supabase start`
# and the hosted platform both inject these three variables automatically.
# Supply them explicitly only to point local functions at a hosted project:
#
#   supabase functions serve --env-file supabase/functions/.env.local
#
# Project Settings > API Keys in the dashboard.

SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable. Safe in a browser, because RLS is what protects the data.
SUPABASE_ANON_KEY=

# Bypasses RLS completely (architecture.md §7). Only `job-*` functions read it.
# Keep it out of git and out of anything that ships to a client.
SUPABASE_SERVICE_ROLE_KEY=
