{
  // Anchors Deno's config lookup here. Without a config file at this level Deno
  // keeps walking up past the repo root, and a stray package.json in a parent
  // directory silently switches resolution into node_modules mode, which breaks
  // the `npm:` specifiers these functions import.
  "nodeModulesDir": "none",

  // Editor-only: Cursor's TypeScript language service cannot resolve `npm:`.
  "exclude": ["_shared/editor.shims.d.ts"],

  // `supabase gen types` emits its own style. Formatting it here would mean
  // every regeneration shows up as a diff.
  "fmt": {
    "exclude": ["_shared/db.types.ts", "_shared/editor.shims.d.ts"]
  },

  "lint": {
    "rules": {
      // Edge Functions resolve `npm:` specifiers natively. Keeping them inline
      // means a function works as deployed no matter which config file the CLI
      // ships alongside it, so the import-map form this rule wants would be a
      // downgrade here.
      "exclude": ["no-import-prefix"]
    }
  }
}
