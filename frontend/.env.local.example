# Local Supabase defaults. For a hosted project, replace both values with
# Project Settings > API values from your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-publishable-or-anon-key

# Server-only. Writes scrape dishes into trends and scores them against
# this restaurant's menu / inventory / sales. Local value: supabase status.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Used by frontend API routes that call agent/.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Server-only. YouTube Data API v3 — viral idea search and marketing evidence.
YOUTUBE_API_KEY=
